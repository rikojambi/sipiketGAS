{
  "name": "sipiket",
  "version": "1.0.0",
  "private": true,
  "description": "Sistem Informasi Piket Guru dan Monitoring Kehadiran Siswa - PWA frontend untuk Netlify dengan backend Google Apps Script",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
